# 8b. TF activity via decoupleR + CollecTRI regulons.
tf_net <- tryCatch(get_collectri(organism = "human", split_complexes = FALSE),
                   error = function(e) { message("CollecTRI download failed: ", e$message); NULL })

if (!is.null(tf_net)) {
  acts <- run_ulm(mat = expr_sym, net = tf_net,
                  .source = "source", .target = "target", .mor = "mor", minsize = 5)
  # Reshape ulm scores (z-like) into a TF x sample matrix
  tf_mat <- acts %>%
    dplyr::filter(statistic == "ulm") %>%
    dplyr::select(source, condition, score) %>%        # <-- dplyr::select, not the masked one
    tidyr::pivot_wider(names_from = condition, values_from = score) %>%
    tibble::column_to_rownames("source") %>%
    as.matrix()
  tf_mat <- tf_mat[, sample_metadata$Sample, drop = FALSE]   
  
  tf_cmp <- compare_groups(tf_mat, group)
  write.csv(tf_cmp, "13_TF_activity_group_comparison.csv")
  
  # Plot the 25 TFs with the largest group difference
  top_tf <- head(rownames(tf_cmp[order(-abs(tf_cmp$delta)), ]), 25)
  pdf("13_TF_activity_heatmap.pdf", width = 10, height = 9)
  pheatmap(tf_mat[top_tf, ], annotation_col = col_anno,
           annotation_colors = ann_colors,
           color = colorRampPalette(c("navy", "white", "firebrick"))(100),
           cluster_cols = TRUE,
           fontsize     = 14,   # <-- group labels (Stress / No Stress) + legend
           fontsize_row = 14,    # TF names (kept small for the 25 rows)
           main = "TF activity (decoupleR/CollecTRI, top 25 by |delta|)")
  dev.off()
}

# ============================================================================
# 9. SINGLE-GENE FOLLOW-UP: BTNL3
# ============================================================================
btnl3_idx <- which(MA$`Gene Symbol` == "BTNL3")

if (length(btnl3_idx) == 0) {
  cat("BTNL3 not found. Related BTN genes:\n")
  print(unique(grep("BTN", MA$`Gene Symbol`, value = TRUE, ignore.case = TRUE)))
} else {
  # Coerce via matrix and average across probes if BTNL3 maps to >1 row.
  m <- matrix(as.numeric(as.matrix(MA[btnl3_idx, 1:29])), nrow = length(btnl3_idx))
  btnl3_values <- colMeans(m, na.rm = TRUE)
  
  btnl3_data <- data.frame(
    Sample = new_names,
    Expression = btnl3_values,
    Group = factor(ifelse(grepl("^0_", new_names), "No Stressor", "With Stressor"),
                   levels = c("No Stressor", "With Stressor")))
  
  summary_stats <- btnl3_data %>%
    group_by(Group) %>%
    summarise(N = n(), Mean = mean(Expression), SD = sd(Expression),
              Median = median(Expression), .groups = "drop")
  print(summary_stats)
  
  m0 <- summary_stats$Mean[summary_stats$Group == "No Stressor"]
  m1 <- summary_stats$Mean[summary_stats$Group == "With Stressor"]
  s0 <- summary_stats$SD[summary_stats$Group == "No Stressor"]
  s1 <- summary_stats$SD[summary_stats$Group == "With Stressor"]
  n0 <- summary_stats$N[summary_stats$Group == "No Stressor"]
  n1 <- summary_stats$N[summary_stats$Group == "With Stressor"]
  
  log2fc    <- m1 - m0                                    # raw (unadjusted) mean difference
  sd_pooled <- sqrt(((n0 - 1) * s0^2 + (n1 - 1) * s1^2) / (n0 + n1 - 2))
  cohens_d  <- log2fc / sd_pooled
  
  # Moderated limma stats 
  limma_rows <- intersect(paste0("Gene_", btnl3_idx), rownames(results))
  if (length(limma_rows) > 0) {
    cat("\nBTNL3 limma (moderated) stats:\n")
    print(results[limma_rows, c("logFC", "t", "P.Value", "adj.P.Val")])
  }
  # adjusted logFC from the DE model 
  limma_logfc <- if (length(limma_rows) > 0) mean(results[limma_rows, "logFC"], na.rm = TRUE) else NA
  
  welch <- t.test(Expression ~ Group, data = btnl3_data)
  cat(sprintf("limma logFC (adj.) = %.3f | raw \u0394mean = %.3f | Cohen's d = %.3f | Welch p = %.4g\n",
              limma_logfc, log2fc, cohens_d, welch$p.value))
  
  p <- ggplot(btnl3_data, aes(Group, Expression, fill = Group)) +
    geom_violin(alpha = 0.3, trim = FALSE, color = "black") +
    geom_boxplot(width = 0.3, alpha = 0.7, outlier.shape = NA) +
    geom_jitter(width = 0.15, size = 3, alpha = 0.7, color = "black") +
    stat_summary(fun = mean, geom = "point", shape = 23, size = 4,
                 fill = "yellow", color = "black", stroke = 1.5) +
    scale_fill_manual(values = c("No Stressor" = "#4A90E2", "With Stressor" = "#E24A4A")) +
    labs(title = "BTNL3 Expression: Bipolar Disorder Patients",
         subtitle = sprintf("limma logFC (adj.) = %.3f | raw \u0394mean = %.3f | Cohen's d = %.3f | Welch p = %.3g",
                            limma_logfc, log2fc, cohens_d, welch$p.value),
         x = "", y = "Log2 Expression") +
    theme_bw(base_size = 14) +
    theme(plot.title = element_text(face = "bold", hjust = 0.5),
          plot.subtitle = element_text(hjust = 0.5), legend.position = "none")
  ggsave("14_BTNL3_expression.pdf", p, width = 9, height = 7)
  write.csv(btnl3_data, "14_BTNL3_expression_values.csv", row.names = FALSE)
}

