# ============================================================================
# 3. DIFFERENTIAL EXPRESSION WITH LIMMA
# ============================================================================
sample_metadata$BD_type <- factor(sample_metadata$BD_type)        # 1 = type 1, 2 = type 2
design <- model.matrix(~ 0 + Group + Age + BD_type, data = sample_metadata)
colnames(design)[colnames(design) == "GroupNo_Stressor"]   <- "No_Stressor"
colnames(design)[colnames(design) == "GroupWith_Stressor"] <- "With_Stressor"
stopifnot(qr(design)$rank == ncol(design))                        

fit  <- lmFit(expr_matrix, design)
contrast_matrix <- makeContrasts(
  Stressor_vs_NoStressor = With_Stressor - No_Stressor, levels = design)
fit2 <- contrasts.fit(fit, contrast_matrix)
fit2 <- eBayes(fit2, trend = TRUE)   

# DE-model QC plots (the array analog of the airway MA plot).
pdf("05_limma_QC.pdf", width = 12, height = 6)
par(mfrow = c(1, 2))
limma::plotMA(fit2, main = "MA plot (Stressor vs No Stressor)")
abline(h = 0, col = "red")
limma::plotSA(fit2, main = "Mean-variance trend (eBayes fit)")
dev.off()

results <- topTable(fit2, coef = "Stressor_vs_NoStressor", number = Inf, sort.by = "P")
results$Gene_Symbol <- gene_info[rownames(results), "Gene_Symbol"]
results$Description  <- gene_info[rownames(results), "Description"]
results <- results[, c("Gene_Symbol", "Description", "logFC", "AveExpr",
                       "t", "P.Value", "adj.P.Val", "B")]


FDR <- 0.05; LFC <- 1
sig    <- results$adj.P.Val < FDR
