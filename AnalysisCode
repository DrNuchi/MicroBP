compare_groups <- function(score_mat, grp, ref = "No_Stressor") {
  out <- t(apply(score_mat, 1, function(x) {
    a <- x[grp == ref]; b <- x[grp != ref]
    tt <- tryCatch(t.test(b, a), error = function(e) list(p.value = NA))
    c(mean_ref = mean(a), mean_other = mean(b),
      delta = mean(b) - mean(a), p_value = tt$p.value)
  }))
  out <- as.data.frame(out)
  out$padj <- p.adjust(out$p_value, "BH")
  out[order(out$p_value), ]
}

