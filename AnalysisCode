to_entrez  <- function(s) na.omit(bitr(unique(s), "SYMBOL", "ENTREZID", org.Hs.eg.db)$ENTREZID)
universe   <- ranked$ENTREZID

run_ora <- function(symbols, tag) {
  if (length(symbols) < 5) { cat("ORA skipped (", tag, "): too few genes\n"); return(invisible()) }
  e <- to_entrez(symbols)
  kk <- enrichKEGG(e, organism = "hsa", universe = universe, pvalueCutoff = 0.1)
  go <- enrichGO(e, OrgDb = org.Hs.eg.db, ont = "BP", universe = universe,
                 keyType = "ENTREZID", pvalueCutoff = 0.1, readable = TRUE)
  if (!is.null(kk)) write.csv(as.data.frame(kk), paste0("08_ORA_KEGG_", tag, ".csv"), row.names = FALSE)
  if (!is.null(go)) write.csv(as.data.frame(go), paste0("08_ORA_GO_",   tag, ".csv"), row.names = FALSE)
  cat("ORA done (", tag, ")\n")
}
